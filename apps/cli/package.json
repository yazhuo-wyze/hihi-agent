{
  "name": "@hihi-agent/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": { "hihi": "./bin/hihi.mjs" },
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean --external @github/copilot-sdk --external @modelcontextprotocol/sdk --external @hihi-agent/core --external @hihi-agent/shared",
    "build:pack": "tsup --config tsup.pack.config.ts",
    "pack:bin": "pnpm build:pack && pkg . --no-bytecode --public-packages \"*\" --public --compress GZip --out-path pack/bin",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "start": "node bin/hihi.mjs"
  },
  "dependencies": {
    "@hihi-agent/core": "workspace:*",
    "@hihi-agent/shared": "workspace:*",
    "@github/copilot-sdk": "^1.0.0",
    "commander": "^12.0.0",
    "chalk": "^5.3.0",
    "prompts": "^2.4.2",
    "ora": "^8.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/prompts": "^2.4.9",
    "@yao-pkg/pkg": "^6.20.0",
    "tsup": "^8.0.2",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  },
  "pkg": {
    "scripts": [
      "pack/index.cjs"
    ],
    "assets": [
      "node_modules/pino/**/*",
      "node_modules/pino-pretty/**/*",
      "node_modules/pino-roll/**/*",
      "node_modules/thread-stream/**/*",
      "node_modules/sonic-boom/**/*",
      "../../node_modules/.pnpm/pino@*/node_modules/pino/**/*",
      "../../node_modules/.pnpm/pino-pretty@*/node_modules/pino-pretty/**/*",
      "../../node_modules/.pnpm/pino-roll@*/node_modules/pino-roll/**/*",
      "../../node_modules/.pnpm/thread-stream@*/node_modules/thread-stream/**/*",
      "../../node_modules/.pnpm/sonic-boom@*/node_modules/sonic-boom/**/*"
    ],
    "targets": [
      "node20-linux-x64",
      "node20-linux-arm64",
      "node20-macos-x64",
      "node20-macos-arm64",
      "node20-win-x64",
      "node20-win-arm64"
    ]
  }
}
