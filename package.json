{
  "name": "hihi-agent",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" --filter \"./apps/cli\" build",
    "build:web": "pnpm --filter ./apps/web build",
    "dev:cli": "pnpm --filter ./apps/cli dev",
    "dev:web": "pnpm --filter ./apps/web dev",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "typescript": "^5.4.5",
    "tsup": "^8.0.2",
    "tsx": "^4.7.2",
    "vitest": "^1.6.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/parser": "^7.7.0",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "prettier": "^3.2.5"
  }
}
